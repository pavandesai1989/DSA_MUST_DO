class Solution {
public:
    bool containsDuplicate(vector<int>& nums) 
    {
        unordered_map<int,int> freq;
        for(auto ele:nums)
        {
            freq[ele]++;
        }

        for(auto ele:freq)
        {
            if(ele.second > 1) return true;
        }
        return false;
    }
};

