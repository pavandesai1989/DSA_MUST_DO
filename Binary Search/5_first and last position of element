Memory:
FIRST → LEFT because we need first occurance move to left 
LAST → RIGHT because we need last occurance move to right

Loop: while (l <= r)
Time: O(log n)
Space: O(1)


class Solution {
public:

    int findTheFirstOccurance(vector<int>& nums, int l,int r,int target)
    {
        int first = -1;
        while(l<=r)
        {
            int mid=(r-l)/2+l;

            if(nums[mid]==target)
            {
                first = mid;
                //move left 
                r=mid-1;
            }
            else if(nums[mid]<target)
            {
                l=mid+1;
            }
            else
            {
                r=mid-1;
            }
        }
        return first;
    }

    int findTheLastOccurance(vector<int>& nums, int l,int r,int target)
    {
        int last = -1;
        while(l<=r)
        {
            int mid=(r-l)/2+l;

            if(nums[mid]==target)
            {
                last = mid;
                //move right 
                l=mid+1;
            }
            else if(nums[mid]<target)
            {
                l=mid+1;
            }
            else
            {
                r=mid-1;
            }
        }
        return last;
    }

    vector<int> searchRange(vector<int>& nums, int target) 
    {
        int n=nums.size();
        int l=0,r=n-1;

        int first = findTheFirstOccurance(nums,l,r,target);
        int last = findTheLastOccurance(nums,l,r,target);

        return {first,last};
    }
};
