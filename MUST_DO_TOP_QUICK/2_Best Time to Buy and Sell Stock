class Solution {
public:
    int maxProfit(vector<int>& prices) 
    {
        int n=prices.size();
        int maxprofit=0;
        for(int i=0;i<n;i++)
        {
            for(int j=i+1;j<n;j++)
            {
                maxprofit = max(maxprofit,prices[j]-prices[i]);
            }
        }
        return maxprofit == INT_MIN ? 0 : maxprofit;
    }
};

class Solution {
public:
    int maxProfit(vector<int>& prices) 
    {
        int n = prices.size();
        int minval = prices[0];   // Minimum price seen so far
        int maxprofit = 0;

        for(int i = 0; i < n; i++)
        {
            minval = min(minval, prices[i]);
            maxprofit = max(maxprofit, prices[i] - minval);
        }

        return maxprofit;
    }
};
