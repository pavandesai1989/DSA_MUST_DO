class Solution {
public:
    int characterReplacement(string s, int k) 
    {
        int n=s.size();
        int maxlen=0;
        for(int i=0;i<n;i++)
        {
            unordered_map<char,int> freq;
            int maxfreq=0;
            for(int j=i;j<n;j++)
            {
                freq[s[j]]++;
                maxfreq = max(maxfreq,freq[s[j]]);
                int len=j-i+1;

                if(len-maxfreq > k) break;
                maxlen = max(maxlen,len);
            }
        }
        return maxlen;
    }
};

