class Solution {
public:
    double findMaxAverage(vector<int>& nums, int k) 
    {
        double res=INT_MIN;
        int n=nums.size();
        int l=0,r=0;
        int sum=0;

        while(r<n)
        {
            sum += nums[r];
            
            if( r-l+1 == k)//vvvvimp 
            {
                res = max(res,(double)sum/k);
                sum -= nums[l];
                l++;
            }
            r++;
        }
        return res;
    }
};
