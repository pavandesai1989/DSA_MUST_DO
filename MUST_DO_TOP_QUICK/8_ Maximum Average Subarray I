https://leetcode.com/problems/maximum-average-subarray-i/

class Solution {
public:
    double findMaxAverage(vector<int>& nums, int k) 
    {
        double res=INT_MIN;
        int n=nums.size();
        for(int i=0;i<=n-k;i++)
        {
            double avg=INT_MIN;
            int sum=0;
            for(int j=i;j<i+k;j++)
            {
                sum += nums[j];
            }
            avg = (double)sum/k;
            res = max(res,avg);
        }
        return res;
    }
};

